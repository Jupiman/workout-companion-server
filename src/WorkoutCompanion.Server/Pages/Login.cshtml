@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="login-card">
    <p class="eyebrow">Private server</p>
    <h1>Sign in</h1>
    <p>Use the same API token configured in the Android app.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Token">Server token</label>
        <input asp-for="Token" autocomplete="current-password" autofocus />
        <button class="primary-button" type="submit">Sign in</button>
    </form>
</section>

